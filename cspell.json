{
  "version": "0.2",
  "language": "en,en-GB,en-US",
  "useGitignore": true,
  "enableGlobDot": true,
  "files": [
    "**/*.{md,txt,json,jsonc,yaml,yml,toml,proto,js,mjs,cjs,jsx,ts,mts,cts,tsx,rs,kt,kts,xml,properties,ps1,sh,bash,zsh}",
    ".editorconfig",
    ".gitattributes",
    ".gitignore",
    ".npmrc",
    ".node-version",
    "LICENSE",
    "NOTICE",
    "VERSION",
    "shared/tools/protocol-codegen/bin/**"
  ],
  "ignorePaths": [
    ".git/**",
    ".git/hooks/**",
    "**/.git/**",
    "node_modules/**",
    "**/build/**",
    "**/dist/**",
    "**/target/**",
    "shared/generated/**",
    "shared/protocol/descriptor/**",
    "shared/protocol/fixtures/**/*.bin",
    "pnpm-lock.yaml",
    "Cargo.lock",
    "gradlew",
    "gradlew.bat",
    "gradle/wrapper/**"
  ],
  "overrides": [
    {
      "filename": ".github/labels.json",
      "ignoreRegExpList": ["/\"color\"\\s*:\\s*\"[0-9a-fA-F]{6}\"/g"]
    },
    {
      "filename": ".github/workflows/security.yml",
      "ignoreRegExpList": [
        "/AKIA\\[0-9A-Z\\]\\{16\\}/g",
        "/gh\\[pousr\\]_\\[A-Za-z0-9\\]\\{36,\\}/g"
      ]
    }
  ],
  "words": [
    "AAEC",
    "AKIA",
    "AQIDBAUG",
    "AndroidX",
    "AppImage",
    "Biome",
    "Bufbuild",
    "ChaCha",
    "Clippy",
    "Corepack",
    "CycloneDX",
    "DataStore",
    "DevSecOps",
    "Dfile",
    "EBES",
    "Gradle",
    "HKDF",
    "Jetpack",
    "Keystore",
    "Kotlin",
    "LASTEXITCODE",
    "Protobuf",
    "Rustfmt",
    "SLSA",
    "Varint",
    "WebSocket",
    "Wlpa",
    "Yandex",
    "buildconfig",
    "buildfeatures",
    "codegen",
    "crates",
    "dalek",
    "denylist",
    "dists",
    "endregion",
    "gradlew",
    "jvmargs",
    "libprotoc",
    "lockfiles",
    "mDNS",
    "monorepo",
    "msrv",
    "nonregressing",
    "nonterminal",
    "now-playing",
    "oneof",
    "oneofs",
    "ossf",
    "pnpm",
    "pousr",
    "profraw",
