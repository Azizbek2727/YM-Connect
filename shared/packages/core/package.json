{
  "name": "@ym-connect/core",
  "version": "0.1.0",
  "description": "Runtime-neutral protocol abstractions and validation for YM Connect.",
  "type": "module",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "README.md",
    "src"
  ],
  "scripts": {
    "build": "node --check src/index.js",
    "format:check": "pnpm dlx @biomejs/biome@2.5.6 check src test",
    "lint": "pnpm dlx @biomejs/biome@2.5.6 lint src test",
    "test": "node --test",
    "typecheck": "pnpm --package=typescript@7.0.2 dlx tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2024 src/index.d.ts"
  },
  "dependencies": {
    "@ym-connect/protocol": "workspace:*"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "license": "Apache-2.0"
}
